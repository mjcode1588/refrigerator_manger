APP_NAME="Refrigerator Manager API"
APP_ENV=local
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# 사용할 DB 프로바이더 선택: sqlite | supabase | postgres | oracle
DB_PROVIDER=sqlite
DATABASE_URL=sqlite:///./local_dev.db

# [Option A: Supabase PostgreSQL 사용 시]
# DB_PROVIDER=supabase
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_USE_TRANSACTION_POOLER=false

# [Option B: OCI Autonomous DB (Oracle) 사용 시]
# DB_PROVIDER=oracle
# DATABASE_URL=oracle+oracledb://ADMIN:<password>@<adb-dsn>
# ORACLE_WALLET_DIR=
# ORACLE_WALLET_PASSWORD=

# [Option C: VM 내 Docker PostgreSQL 테스트 시 (compose.prod.yml)]
# COMPOSE_PROFILES=local-db
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql+psycopg://fridge_user:fridge_password@postgres:5432/fridge
# POSTGRES_USER=fridge_user
# POSTGRES_PASSWORD=fridge_password
# POSTGRES_DB=fridge

# [Caddy 리버스 프록시 주소]
# IP 테스트: :80 (기본값) / 도메인 HTTPS: api.yourdomain.duckdns.org
# SITE_ADDRESS=:80
# 운영(HTTPS): SITE_ADDRESS=myfridges.duckdns.org
# Android APK 배포 URL 경로 (/releases/<APK_DOWNLOAD_PATH>/). 가족 전용 접근을 위해 추측하기 어려운 값 권장
APK_DOWNLOAD_PATH=apk

# DB 커넥션 풀 설정 (무료 티어 보호)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# JWT 인증 설정
JWT_SECRET_KEY=change-this-to-a-random-64-byte-hex-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30

# 가족 전용 자체 인증 및 체험 로그인 설정
# 운영(APP_ENV != local)에서는 ALLOW_DEV_LOGIN=false 및 32자 이상 JWT_SECRET_KEY 필수 (아니면 기동 차단)
ALLOW_DEV_LOGIN=true
# 2인 가입 완료 후에는 비워두거나 MAX_REGISTERED_USERS=2에 의해 자동 차단됩니다 (설정 시 8자 이상 권장)
FAMILY_REGISTRATION_CODE=our-home-secret-2026
MAX_REGISTERED_USERS=2
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Rate Limiting / 프록시 신뢰 대역
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_JOIN_PER_MINUTE=10
# FORWARDED_ALLOW_IPS=172.16.0.0/12
