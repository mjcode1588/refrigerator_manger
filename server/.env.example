APP_NAME="Refrigerator Manager API"
APP_ENV=local
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# 사용할 DB 프로바이더 선택: sqlite | supabase | postgres | oracle
DB_PROVIDER=sqlite
DATABASE_URL=sqlite:///./local_dev.db

# [Option A: Supabase PostgreSQL 사용 시]
# DB_PROVIDER=supabase
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_USE_TRANSACTION_POOLER=false

# [Option B: OCI Autonomous DB (Oracle) 사용 시]
# DB_PROVIDER=oracle
# DATABASE_URL=oracle+oracledb://ADMIN:<password>@<adb-dsn>
# ORACLE_WALLET_DIR=
# ORACLE_WALLET_PASSWORD=

# DB 커넥션 풀 설정 (무료 티어 보호)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# JWT 인증 설정
JWT_SECRET_KEY=change-this-to-a-random-64-byte-hex-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30

# 소셜 로그인 설정
GOOGLE_CLIENT_ID=
KAKAO_REST_API_KEY=
